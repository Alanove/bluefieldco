noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph idx="4294967295"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="563880" y="777240"/><a:ext cx="11064240" cy="5760720"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>We are established in 2008,</a:t></a:r><a:r><a:rPr lang="en-US" sz="1500" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t> </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>specializing in the realm of Mechanical, Electrical, Plumbing, ICT and Renewable Energy Technologies, covering the spectrum of Design, Shop Drawings and Value Engineering services offerings.</a:t></a:r></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>We are guided by optimism,</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t> </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>using the power of design to inspire a positive change and create a future that promotes wellbeing for all, in line with the latest sustainability trends. We focus on the importance of preserving nature and its resources and encourage our clients to apply any opportunity to reduce the overall impact of the built-up environment on the human health and the natural ecosystem. </a:t></a:r></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>We are a diverse team,</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t> composed of experts in the latest Engineering trends in Renewable Energies, Green Building designs, HVAC Systems technologies, Water Systems efficiencies, Power Generation &amp; Distribution as well as new technologies in IT &amp; Low Current systems. Our aim is to provide Total MEP Integrated Solutions, customized to meet the full spectrum of Engineering services through a constructive cross-discipline collaboration.</a:t></a:r></a:p><a:p><a:pPr marL="0" lvl="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>We invest in innovation,</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t> </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>meeting market’s expectations, by pushing the boundaries of design through smartly using AEC modeling technologies offering integrated construction models and virtual reality rendering. We are unlocking and creating new tools to release fast innovative solutions serving the construction industry. We promote education within our teams specially in terms of technology and sustainability, through certificates and diplomas acquired from accredited universities and international organizations.</a:t></a:r></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1500" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>We expand our market,</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t> </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>by benefiting from the communications technology evolutions, to connect with new clients expanding from the Gulf Countries to North American Countries - mainly Canada. From our side, this expansion enabled us to gain a competitive edge in undersaturated markets, foster our expertise through the diversity of shared opinions and methodologies; from our client’s side, this expansion offered them the opportunity to diversify their services, to access additional talents and reduce costs.</a:t></a:r></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1400" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>We come towards our clients,</a:t></a:r><a:r><a:rPr lang="en-US" sz="1200" b="1" kern="0" dirty="0"><a:solidFill><a:schemeClr val="accent5"><a:lumMod val="50000"/></a:schemeClr></a:solidFill><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t> </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:rPr><a:t>by creating CONSULT EMDC in Dubai, UAE to become an attraction hub for an expanding clientele. The scope of CONSULT EMDC is to proactively recognize and pursue opportunities, cultivate old and new clients’ relationships achieving long-term sustainability in the MEP Construction and manage the Business Development, Contracts, Sales and Purchasing activities of both EMDC Group and CONSULT EMDC.</a:t></a:r></a:p><a:p><a:pPr marL="0" indent="0"><a:lnSpc><a:spcPct val="125000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:buNone/></a:pPr><a:endParaRPr lang="en-US" sz="1300" kern="0" dirty="0"><a:latin typeface="Arial Narrow" panose="020B0606020202030204" pitchFamily="34" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="3356165094"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>