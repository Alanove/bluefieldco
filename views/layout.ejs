<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : (typeof siteData !== 'undefined' && siteData.name ? siteData.name : 'BlueField Group') %></title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : '' %>">
  <meta name="keywords" content="<%= typeof pageKeywords !== 'undefined' ? pageKeywords : '' %>">
  <meta name="robots" content="<%= typeof pageRobots !== 'undefined' ? pageRobots : 'index, follow' %>">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : '' %>">
  <meta property="og:description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : '' %>">
  <meta property="og:type" content="<%= typeof pageType !== 'undefined' ? pageType : 'website' %>">
  <meta property="og:url" content="<%= typeof pageUrl !== 'undefined' ? pageUrl : '' %>">
  <meta property="og:image" content="<%= typeof pageImage !== 'undefined' ? pageImage : '' %>">
  <link rel="canonical" href="<%= typeof pageUrl !== 'undefined' ? pageUrl : '' %>">
  <link rel="icon" type="image/png" href="<%= typeof siteData !== 'undefined' && siteData.favicon ? siteData.favicon : '/themes/bluefieldco/images/BLUEFIELD-Favicon.png' %>">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
  <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
  <link rel="stylesheet" type="text/css" href="/themes/bluefieldco/slick/slick.css">
  <link rel="stylesheet" type="text/css" href="/themes/bluefieldco/slick/slick-theme.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@200;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css?family=Lato:400,700" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cookieconsent2/3.0.3/cookieconsent.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">
  <link rel="stylesheet" href="/themes/bluefieldco/style.css">
  <link rel="stylesheet" href="/css/cms-overrides.css">
  <% const isHomePage = typeof bodyClass !== 'undefined' && bodyClass.includes('home'); %>
  <% if (typeof pageImage !== 'undefined' && pageImage && pageImage.trim() !== '' && !isHomePage) { %>
  <style>
    body.page .breadcrumb_wrapper,
    body.page .a-header,
    body.page .a-headerm {
      background-image: url('<%= pageImage %>');
      background-size: cover;
      background-repeat: no-repeat;
      background-position: center;
    }
  </style>
  <% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <div class="back-to-top" style="display: none;">TOP</div>
  <div id="page" class="site">
    <%- include('partials/header') %>
    <%- body %>
    <%- include('partials/footer') %>
  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://code.jquery.com/jquery-migrate-3.4.1.min.js"></script>
  <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cookieconsent2/3.0.3/cookieconsent.min.js"></script>
  <script type="text/javascript" src="/themes/bluefieldco/slick/slick.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
  <script src="/themes/bluefieldco/js/reveal/dist/scrollreveal.min.js"></script>
  <script src="/themes/bluefieldco/js/navigation.js"></script>
  <script src="/themes/bluefieldco/js/reavel-custom.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>
